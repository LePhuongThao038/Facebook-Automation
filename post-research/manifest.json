{
  "manifest_version": 3,
  "name": "Sổ nghiên cứu Facebook",
  "version": "0.2.23",
  "description": "Chọn bài Facebook, gom nội dung, ảnh và hội thoại thành tài liệu nghiên cứu.",
  "key": "",
  "permissions": [
    "scripting",
    "storage",
    "identity",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://*.facebook.com/*",
    "https://*.fbcdn.net/*",
    "https://*.fbsbx.com/*",
    "https://www.googleapis.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://docs.googleapis.com/*"
  ],
  "action": {
    "default_title": "Mở sổ nghiên cứu"
  },
  "background": {
    "service_worker": "worker.js"
  }
}