{
  "manifest_version": 3,
  "name": "Hồ sơ khách hàng",
  "version": "0.1.0",
  "description": "Đọc trang cá nhân CÔNG KHAI của khách đã liên hệ, dựng hồ sơ nhân khẩu và bản đồ tính cách/mua hàng. Chỉ đọc, không tương tác.",
  "key": "",
  "permissions": [
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.facebook.com/*"
  ],
  "action": {
    "default_title": "Mở Hồ sơ khách hàng"
  },
  "background": {
    "service_worker": "worker.js"
  }
}
